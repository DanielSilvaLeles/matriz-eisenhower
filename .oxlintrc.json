{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "react-perf", "typescript", "unicorn", "oxc", "import", "jsx-a11y"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "warn"
  },
  "env": { "browser": true, "es2024": true },
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "typescript/no-unnecessary-condition": "warn",
    "eqeqeq": ["error", "always"],
    // console.error fica liberado para falhas de escrita no banco que ainda
    // nao tem tratamento na interface (toast/undo chegam na fase 1c);
    // console.log e as demais variantes continuam proibidas.
    "no-console": ["warn", { "allow": ["error"] }],

    // __BUILD_INFO__ e a convencao do Vite para variavel injetada por define.
    "no-underscore-dangle": ["error", { "allow": ["__BUILD_INFO__"] }],

    // Importar CSS pelo efeito colateral e o jeito certo no Vite.
    "import/no-unassigned-import": ["error", { "allow": ["**/*.css", "fake-indexeddb/auto"] }],

    // Desligada: com o runtime automatico de JSX (jsx: "react-jsx") o React
    // nao precisa estar em escopo. A regra existe para o runtime classico.
    "react/react-in-jsx-scope": "off",

    // Desligada: exigiria readonly em toda prop de componente e em todo objeto
    // de opcoes. Luta contra o React idiomatico sem pegar bug nenhum aqui.
    "typescript/prefer-readonly-parameter-types": "off",

    // Desligada: marcacao JSX infla a contagem de linhas. Quebrar um componente
    // para agradar um contador de linhas piora a leitura.
    "max-lines-per-function": "off",

    // O padrao (10) e baixo demais para um componente container que liga
    // dominio + banco + acoes + varios filhos - exatamente o papel de
    // QuadrantSection e InboxPanel. 16 ainda pega import excessivo de verdade.
    "import/max-dependencies": ["warn", { "max": 16 }],

    // Em conflito direto com typescript/consistent-return quando uma funcao
    // tipada como `=> T | undefined` tem varios pontos de saida (os
    // callbacks de accessibility.announcements do dnd-kit, por exemplo):
    // misturar `return` nu com `return valor` reprova o consistent-return,
    // mas `return undefined` explicito reprova esta regra. Preferimos a
    // correcao de tipo de retorno (consistent-return) e desligamos esta.
    "unicorn/no-useless-undefined": "off"
  },
  "ignorePatterns": ["dist", "node_modules", "coverage", "apps-script"],
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "vite.config.ts"],
      "env": { "node": true }
    },
    {
      // Testes Playwright: codigo Node/browser-script, nao componentes React -
      // a regra de hooks falsa-positiva no `use` que e o proprio parametro de
      // fixture do Playwright, nao o useX do React.
      "files": ["e2e/**", "playwright.config.ts"],
      "env": { "node": true },
      "rules": { "react-hooks/rules-of-hooks": "off" }
    }
  ]
}
