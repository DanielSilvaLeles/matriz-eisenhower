# Copie para o .env da VPS (/home/apps/.env) - NUNCA commite os valores reais.
# DATABASE_URL: usuário e banco dedicados da matriz (ver api/README.md).
MATRIZ_DATABASE_URL=postgres://matriz_app:TROQUE_A_SENHA@postgres:5432/matriz
# Gere com: openssl rand -hex 32  (o mesmo valor vai no PropertiesService do Apps Script)
MATRIZ_API_KEY=
