{
  "name": "matriz-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "API da Matriz de Eisenhower na VPS (PostgreSQL). Chamada so pelo Apps Script (proxy) - ver api/README.md.",
  "engines": { "node": ">=24" },
  "scripts": {
    "start": "node src/server.ts",
    "migrate": "node src/migrate.ts",
    "import": "node scripts/import.ts",
    "test": "node --test --test-concurrency=1 'test/**/*.test.ts'"
  },
  "dependencies": {
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/pg": "8.23.1"
  }
}
