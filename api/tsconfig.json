{
  // Node roda os .ts direto (type stripping nativo, Node >= 24) - sem build.
  // Este tsconfig existe so para `npm run typecheck` da raiz checar a API
  // (referenciado em ../tsconfig.json).
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": false,
    "types": ["node"]
  },
  "include": ["src", "test", "scripts"]
}
