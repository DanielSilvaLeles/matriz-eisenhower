{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "paths": { "@/*": ["./src/*"] },
    // "vite/client" alem de "node": os testes (Vitest) rodam sobre o Vite
    // de verdade, entao `import.meta.env.VITE_*` (src/appId.ts, extensão
    // "Anotações" - build para dois repositórios, docs/prompt-anotacoes.md
    // seção 1.8) e tao valido em teste quanto no app - sem isto, qualquer
    // arquivo de teste que importe (direta ou indiretamente) um modulo
    // assim falha so na checagem de tipos deste tsconfig, mesmo rodando
    // certinho no Vitest de verdade.
    "types": ["node", "vite/client"]
  },
  "include": [
    "vite.config.ts",
    "playwright.config.ts",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "e2e/**/*.ts"
  ]
}
